# A host tool is tidied in its own tree; with this off (the default) a USE_TIDY build of the parent project does not
# also tidy every host tool it configures.
set(USE_TIDY_HOST_BUILDS
    false
    CACHE BOOL "enable clang-tidy for host builds")

# Shared host builds. Empty (the default): every build tree configures and builds its own copy of each host tool in
# <binary dir>/<primary target>_host_build. Set to a directory: the primary targets listed in HOST_BUILD_SHARED_TARGETS
# are built once per configuration under it, in <root>/<primary target>-<key>, and <primary target>_host_build becomes a
# symbolic link to that tree. The key is a hash of the source directory, the forwarded cache values (the preload), the
# generator, the host compiler environment and the CMake version, so trees that would configure the tool the same way
# share one tree. Configure and build of a shared tree hold <tree>.lock (file(LOCK)), so several build trees may build
# it at the same time.
set(HOST_BUILD_SHARED_ROOT
    ""
    CACHE PATH "share the host builds of HOST_BUILD_SHARED_TARGETS between build trees under this directory")
set(HOST_BUILD_SHARED_TARGETS
    ""
    CACHE STRING "primary targets of configure_host_build() whose host build may be shared")

function(configure_host_build)

    cmake_parse_arguments(PARSE_ARGV 0 PARSED_ARGS "CLEAR_ENV" "" "FORWARD_VARS")

    set(all_targets ${PARSED_ARGS_UNPARSED_ARGUMENTS})
    list(GET all_targets 0 primary_target)

    if(PARSED_ARGS_CLEAR_ENV)
        unset(ENV{CC})
        unset(ENV{CXX})
    endif()

    set(local_dir ${CMAKE_CURRENT_BINARY_DIR}/${primary_target}_host_build)
    set(cmake_extra_args "-G${CMAKE_GENERATOR}")

    set(preload_text "# Autogenerated preload for host build\n")

    get_cmake_property(all_variables CACHE_VARIABLES)
    foreach(variable_name ${all_variables})
        if(variable_name MATCHES "^USE"
           OR variable_name MATCHES "^TIDY"
           OR variable_name MATCHES "^CMAKE_BUILD_TYPE"
           OR variable_name MATCHES "^FETCHCONTENT_SOURCE_DIR_")

            get_property(
                var_type
                CACHE ${variable_name}
                PROPERTY TYPE)
            if(NOT var_type)
                set(var_type STRING)
            endif()

            string(APPEND preload_text "set(${variable_name} \"${${variable_name}}\" CACHE ${var_type} \"\")\n")
        endif()
    endforeach()

    foreach(variable_name IN LISTS PARSED_ARGS_FORWARD_VARS)
        get_property(
            var_type
            CACHE ${variable_name}
            PROPERTY TYPE)
        if(NOT var_type)
            set(var_type STRING)
        endif()
        string(APPEND preload_text "set(${variable_name} \"${${variable_name}}\" CACHE ${var_type} \"\" FORCE)\n")
    endforeach()

    if(NOT USE_TIDY_HOST_BUILDS)
        string(APPEND preload_text "set(USE_TIDY OFF CACHE BOOL \"\" FORCE)\n")
    endif()

    set(shared OFF)
    if(HOST_BUILD_SHARED_ROOT AND primary_target IN_LIST HOST_BUILD_SHARED_TARGETS)
        string(
            SHA256
                key
                "${CMAKE_CURRENT_LIST_DIR}\n${preload_text}\n${CMAKE_GENERATOR}\n$ENV{CC}\n$ENV{CXX}\n${CMAKE_VERSION}\n"
        )
        string(SUBSTRING ${key} 0 12 key)
        set(shared ON)
    endif()

    if(shared)
        set(build_dir ${HOST_BUILD_SHARED_ROOT}/${primary_target}-${key})
        file(MAKE_DIRECTORY ${HOST_BUILD_SHARED_ROOT})
        # One configure per key: the key holds the whole preload, so a tree that would forward another value gets
        # another directory. Later source changes re-run cmake inside the shared tree's own build.
        file(
            LOCK ${build_dir}.lock
            GUARD FUNCTION
            TIMEOUT 3600)
        if(NOT EXISTS ${build_dir}/CMakeCache.txt OR NOT (EXISTS ${build_dir}/build.ninja OR EXISTS
                                                                                             ${build_dir}/Makefile))
            file(MAKE_DIRECTORY ${build_dir})
            file(WRITE ${build_dir}/preload.cmake "${preload_text}")
            execute_process(
                COMMAND ${CMAKE_COMMAND} -C ${build_dir}/preload.cmake -S ${CMAKE_CURRENT_LIST_DIR} -B ${build_dir}
                        ${cmake_extra_args}
                WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
                RESULT_VARIABLE STATUS COMMAND_ERROR_IS_FATAL ANY)
            if(STATUS AND NOT STATUS EQUAL 0)
                message(FATAL_ERROR "configuring ${primary_target} in ${build_dir} failed!")
            endif()
        endif()
        file(LOCK ${build_dir}.lock RELEASE)

        set(link_ok OFF)
        if(IS_SYMLINK ${local_dir})
            file(READ_SYMLINK ${local_dir} link_target)
            if(link_target STREQUAL build_dir)
                set(link_ok ON)
            endif()
        endif()
        if(NOT link_ok)
            file(REMOVE ${local_dir}) # a link elsewhere; a real directory stays, and CREATE_LINK fails on it
            file(CREATE_LINK ${build_dir} ${local_dir} SYMBOLIC)
        endif()
        message(STATUS "${primary_target}: shared host build ${build_dir}")

        set(locked_script -P ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HostBuildLocked.cmake)
        set(clean_command ${CMAKE_COMMAND} -DHOST_BUILD_DIR=${build_dir} -DHOST_BUILD_TARGET=clean ${locked_script})
    else()
        set(build_dir ${local_dir})
        # A symbolic link left from a shared build (the share turned off again): this tree gets its own copy.
        if(IS_SYMLINK ${build_dir})
            file(REMOVE ${build_dir})
        endif()

        set(preload_file ${build_dir}/preload.cmake)
        file(MAKE_DIRECTORY ${build_dir})
        file(WRITE ${preload_file} "${preload_text}")

        execute_process(
            COMMAND ${CMAKE_COMMAND} -C ${preload_file} -S ${CMAKE_CURRENT_LIST_DIR} -B ${build_dir} ${cmake_extra_args}
            WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
            RESULT_VARIABLE STATUS COMMAND_ERROR_IS_FATAL ANY)

        if(STATUS AND NOT STATUS EQUAL 0)
            message(FATAL_ERROR "configuring ${primary_target} failed!")
        endif()

        set(clean_command ${CMAKE_COMMAND} --build ${build_dir} --target clean)
    endif()

    add_custom_target(
        ${primary_target}_clean
        COMMAND ${clean_command}
        COMMENT "Cleaning host build: ${primary_target}")

    foreach(target IN LISTS all_targets)
        if(shared)
            set(target_command ${CMAKE_COMMAND} -DHOST_BUILD_DIR=${build_dir} -DHOST_BUILD_TARGET=${target}
                               ${locked_script})
        else()
            set(target_command ${CMAKE_COMMAND} --build ${build_dir} --target ${target})
        endif()
        add_custom_target(
            ${target}
            COMMAND ${target_command}
            WORKING_DIRECTORY ${local_dir}
            BYPRODUCTS ${local_dir}/${target}
            COMMENT "Building host tool: ${target}")
        set_target_properties(${target} PROPERTIES HOST_EXECUTABLE_PATH ${local_dir}/${target})
    endforeach()

endfunction()
